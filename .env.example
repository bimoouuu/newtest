# Copie ce fichier en .env et remplis les valeurs. Ne jamais commiter .env.

# --- Discord (obligatoire) ---
DISCORD_TOKEN=
# Clic droit sur le serveur / le salon / le rôle → « Copier l'identifiant » (mode développeur activé)
DISCORD_GUILD_ID=
NOTIF_CHANNEL_ID=
NOTIF_ROLE_ID=

# --- MariaDB (obligatoire) ---
# DB_HOST et DB_PORT sont fixés par docker-compose ; utiles seulement hors Docker
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bimouia
DB_PASSWORD=
DB_NAME=bimouia

# --- Twitch : annonce automatique des lives (laisser vide pour désactiver) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Nom de la chaîne tel qu'il apparaît dans l'adresse twitch.tv/<nom>
TWITCH_LOGIN=
# Délai entre deux vérifications, en secondes
TWITCH_INTERVAL=60

# --- YouTube : annonce automatique des vidéos (laisser vide pour désactiver) ---
# Identifiant de chaîne en UC… (youtube.com/account_advanced)
YOUTUBE_CHANNEL_ID=
YOUTUBE_INTERVAL=300

# --- TikTok ---
# Pour la commande /live tiktok (sans le @)
TIKTOK_USERNAME=
# Annonce automatique des vidéos (laisser vide pour désactiver)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Adresse de redirection déclarée dans l'appli TikTok, à l'identique
TIKTOK_REDIRECT_URI=
TIKTOK_INTERVAL=600
